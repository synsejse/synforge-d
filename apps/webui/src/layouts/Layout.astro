---
import "../styles/global.css";
import { radixCustomStyles } from "../lib/radix-theme";
import FaIcon from "../components/ui/FaIcon";
import Navigation from "../components/ui/Navigation";
import {
    faArrowDownWideShort,
    faBoxesStacked,
    faBookOpen,
    faChartLine,
    faFolderTree,
    faGaugeHigh,
    faSliders,
    faUsers,
} from "@fortawesome/free-solid-svg-icons";

interface Props {
    title: string;
}

const { title } = Astro.props;
const currentPath = Astro.url.pathname;
const publicApiUrl = import.meta.env.PUBLIC_API_URL || "";

const navItems = [
    {
        href: "/",
        label: "Overview",
        icon: faGaugeHigh,
        description: "System summary",
    },
    {
        href: "/packages/",
        label: "Packages",
        icon: faBoxesStacked,
        description: "Sources and history",
    },
    {
        href: "/repository/",
        label: "Repository",
        icon: faFolderTree,
        description: "Published files",
    },
    {
        href: "/repository/use/",
        label: "Add Repo",
        icon: faArrowDownWideShort,
        description: "Fedora setup",
    },
    {
        href: "/jobs/",
        label: "Jobs",
        icon: faChartLine,
        description: "Runs and live traces",
    },
    {
        href: "/users/",
        label: "Users",
        icon: faUsers,
        description: "Accounts and permissions",
    },
    {
        href: "/docs/",
        label: "Docs",
        icon: faBookOpen,
        description: "API reference",
    },
    {
        href: "/settings/",
        label: "Settings",
        icon: faSliders,
        description: "Daemon config",
    },
];
---

<!doctype html>
<html lang="en" class="h-full" data-theme="dark">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title} | Synforge</title>
        <style set:html={radixCustomStyles} />
    </head>
    <body class="h-full overflow-hidden antialiased">
        <a
            href="#main-content"
            class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:border focus:border-zinc-200 focus:bg-zinc-100 focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-black"
        >
            Skip to main content
        </a>
        <div class="fixed inset-0 -z-10 overflow-hidden">
            <div class="app-chrome absolute inset-0"></div>
            <div class="app-grid absolute inset-0 opacity-60"></div>
        </div>

        <div
            id="auth-screen"
            class="hidden min-h-full items-center justify-center px-6 py-12"
        >
            <div class="w-full max-w-md border-4 border-white bg-black p-8 shadow-[6px_6px_0_rgba(255,255,255,0.25)]">
                <div class="mb-8">
                    <p
                        class="font-mono text-xs font-bold uppercase tracking-[0.3em] text-[var(--theme-accent-lime)]"
                    >
                        Synforge
                    </p>
                    <h1 class="mt-3 font-mono text-3xl font-bold uppercase text-zinc-50">
                        Authorize WebUI
                    </h1>
                    <p
                        id="auth-message"
                        class="mt-3 text-sm leading-6 text-zinc-400"
                    >
                        Enter a valid account handle and password to manage
                        packages, builds, and logs.
                    </p>
                </div>

                <form id="auth-form" class="space-y-4">
                    <label class="block">
                        <span
                            class="mb-2 block font-mono text-xs font-bold uppercase tracking-[0.16em] text-zinc-300"
                            >Handle</span
                        >
                        <input
                            id="auth-handle"
                            type="text"
                            class="w-full border-2 border-zinc-700 bg-black px-4 py-3 font-mono text-sm text-zinc-100 outline-none transition duration-100 ease-linear focus:border-[var(--theme-accent-lime)] focus:ring-2 focus:ring-[var(--theme-accent-lime)]"
                            placeholder="admin"
                            autocomplete="username"
                        />
                    </label>
                    <label class="block">
                        <span
                            class="mb-2 block font-mono text-xs font-bold uppercase tracking-[0.16em] text-zinc-300"
                            >Password</span
                        >
                        <input
                            id="auth-password"
                            type="password"
                            class="w-full border-2 border-zinc-700 bg-black px-4 py-3 font-mono text-sm text-zinc-100 outline-none transition duration-100 ease-linear focus:border-[var(--theme-accent-lime)] focus:ring-2 focus:ring-[var(--theme-accent-lime)]"
                            placeholder="Password"
                            autocomplete="current-password"
                        />
                    </label>
                    <p
                        id="auth-error"
                        class="hidden border-2 border-[var(--theme-error-red)] bg-black px-3 py-2 text-sm text-zinc-200"
                    >
                    </p>
                    <button
                        type="submit"
                        class="w-full border-2 border-[var(--theme-accent-lime)] bg-[var(--theme-accent-lime)] px-4 py-3 font-mono text-xs font-bold uppercase tracking-[0.16em] text-black transition duration-100 ease-linear hover:-translate-x-[1px] hover:-translate-y-[1px] hover:bg-[#d8ff72]"
                    >
                        Enter Console
                    </button>
                </form>
            </div>
        </div>

        <div
            id="setup-screen"
            class="hidden min-h-full items-start justify-center px-6 py-6 lg:items-center lg:py-12"
        >
            <div
                class="flex max-h-[calc(100vh-3rem)] w-full max-w-2xl flex-col overflow-hidden border-4 border-white bg-black shadow-[6px_6px_0_rgba(255,255,255,0.25)] lg:max-h-[calc(100vh-6rem)] xl:max-w-3xl"
            >
                <div class="mb-8 shrink-0 border-b-2 border-zinc-800 px-8 pt-8 pb-6">
                    <p
                        class="font-mono text-xs font-bold uppercase tracking-[0.3em] text-[var(--theme-accent-lime)]"
                    >
                        Synforge
                    </p>
                    <h1 class="mt-3 font-mono text-3xl font-bold uppercase text-zinc-50">
                        First Run Setup
                    </h1>
                    <p
                        id="setup-message"
                        class="mt-3 text-sm leading-6 text-zinc-400"
                    >
                        Create the daemon config file and the initial admin
                        account.
                    </p>
                    <p
                        id="setup-step-label"
                        class="mt-3 font-mono text-xs font-bold uppercase tracking-[0.22em] text-zinc-500"
                    >
                        Step 1 of 2 · Configuration
                    </p>
                </div>

                <div class="min-h-0 flex-1 overflow-y-auto px-8 pb-8 pt-0">
                    <form id="setup-form" class="pb-1">
                        <div id="setup-step-config" class="space-y-4">
                            <div class="grid gap-4 xl:grid-cols-2">
                                <div id="setup-config-fields" class="contents">
                                </div>
                            </div>
                        </div>

                        <div id="setup-step-admin" class="hidden space-y-4">
                            <div class="grid gap-4 xl:grid-cols-2">
                                <label class="block">
                                    <span
                                        class="mb-2 block font-mono text-xs font-bold uppercase tracking-[0.16em] text-zinc-300"
                                        >Admin handle</span
                                    >
                                    <input
                                        id="setup-admin-handle"
                                        type="text"
                                        value="admin"
                                        required
                                        class="w-full border-2 border-zinc-700 bg-black px-4 py-3 font-mono text-sm text-zinc-100 outline-none transition duration-100 ease-linear focus:border-[var(--theme-accent-lime)] focus:ring-2 focus:ring-[var(--theme-accent-lime)]"
                                    />
                                </label>
                                <label class="block">
                                    <span
                                        class="mb-2 block font-mono text-xs font-bold uppercase tracking-[0.16em] text-zinc-300"
                                        >Admin display name</span
                                    >
                                    <input
                                        id="setup-admin-display-name"
                                        type="text"
                                        value="Administrator"
                                        required
                                        class="w-full border-2 border-zinc-700 bg-black px-4 py-3 font-mono text-sm text-zinc-100 outline-none transition duration-100 ease-linear focus:border-[var(--theme-accent-lime)] focus:ring-2 focus:ring-[var(--theme-accent-lime)]"
                                    />
                                </label>
                                <label class="block xl:col-span-2">
                                    <span
                                        class="mb-2 block font-mono text-xs font-bold uppercase tracking-[0.16em] text-zinc-300"
                                        >Admin password</span
                                    >
                                    <input
                                        id="setup-admin-password"
                                        type="password"
                                        required
                                        class="w-full border-2 border-zinc-700 bg-black px-4 py-3 font-mono text-sm text-zinc-100 outline-none transition duration-100 ease-linear focus:border-[var(--theme-accent-lime)] focus:ring-2 focus:ring-[var(--theme-accent-lime)]"
                                        placeholder="Choose a strong password"
                                    />
                                </label>
                                <label class="block xl:col-span-2">
                                    <span
                                        class="mb-2 block font-mono text-xs font-bold uppercase tracking-[0.16em] text-zinc-300"
                                        >Confirm password</span
                                    >
                                    <input
                                        id="setup-admin-password-confirm"
                                        type="password"
                                        required
                                        class="w-full border-2 border-zinc-700 bg-black px-4 py-3 font-mono text-sm text-zinc-100 outline-none transition duration-100 ease-linear focus:border-[var(--theme-accent-lime)] focus:ring-2 focus:ring-[var(--theme-accent-lime)]"
                                        placeholder="Re-enter admin password"
                                    />
                                </label>
                            </div>
                        </div>

                        <p
                            id="setup-error"
                            class="mt-4 hidden border-2 border-[var(--theme-error-red)] bg-black px-3 py-2 text-sm text-zinc-200"
                        >
                        </p>
                        <div class="mt-4 flex items-center justify-between gap-3">
                            <button
                                id="setup-back-button"
                                type="button"
                                class="hidden border-2 border-zinc-700 bg-black px-4 py-3 font-mono text-xs font-bold uppercase tracking-[0.16em] text-zinc-200 transition duration-100 ease-linear hover:-translate-x-[1px] hover:-translate-y-[1px] hover:border-white hover:bg-zinc-950"
                            >
                                Back
                            </button>
                            <div class="ml-auto flex items-center gap-3">
                                <button
                                    id="setup-next-button"
                                    type="button"
                                    class="border-2 border-[var(--theme-accent-lime)] bg-[var(--theme-accent-lime)] px-4 py-3 font-mono text-xs font-bold uppercase tracking-[0.16em] text-black transition duration-100 ease-linear hover:-translate-x-[1px] hover:-translate-y-[1px] hover:bg-[#d8ff72]"
                                >
                                    Continue
                                </button>
                                <button
                                    id="setup-submit-button"
                                    type="submit"
                                    class="hidden border-2 border-[var(--theme-accent-lime)] bg-[var(--theme-accent-lime)] px-4 py-3 font-mono text-xs font-bold uppercase tracking-[0.16em] text-black transition duration-100 ease-linear hover:-translate-x-[1px] hover:-translate-y-[1px] hover:bg-[#d8ff72]"
                                >
                                    Initialize Synforge
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div
            id="app-shell"
            class="hidden h-screen box-border px-3 py-3 lg:px-5 lg:py-5"
        >
            <div class="grid h-full gap-3 xl:grid-cols-[280px_minmax(0,1fr)]">
                <aside
                    class="flex min-h-0 flex-col border-4 border-white bg-gradient-to-b from-zinc-900 to-black p-0 shadow-[6px_6px_0_rgba(255,255,255,0.2)]"
                >
                    <div class="border-b-4 border-[var(--theme-border-strong)] bg-black px-6 py-5">
                        <div
                            class="font-mono text-xs font-bold uppercase tracking-[0.35em] text-[var(--theme-accent-lime)]"
                        >
                            Synforge
                        </div>
                        <h1
                            class="font-display mt-2 text-2xl font-extrabold uppercase tracking-tighter text-white"
                        >
                            Build_Control
                        </h1>
                    </div>

                    <Navigation items={navItems} currentPath={currentPath} client:load />

                    <div class="mt-auto border-t-4 border-[var(--theme-border-strong)]">
                        <div class="bg-black px-5 py-5">
                            <div
                                class="font-mono text-xs font-bold uppercase tracking-[0.25em] text-zinc-500"
                            >
                                Session
                            </div>
                            <button
                                id="logout-button"
                                type="button"
                                class="mt-3 w-full border-2 border-[var(--theme-border-strong)] bg-black px-4 py-2.5 text-left font-mono text-sm font-medium text-zinc-200 transition hover:border-white hover:bg-[var(--theme-surface-hover)] focus:outline-none focus:ring-2 focus:ring-[var(--theme-accent-lime)]"
                            >
                                Change account
                            </button>
                        </div>
                    </div>
                </aside>

                <main
                    id="main-content"
                    tabindex="-1"
                    class="min-h-0 overflow-auto border-4 border-white bg-black p-6 lg:p-8 shadow-[6px_6px_0_rgba(255,255,255,0.2)]"
                >
                    <header class="mb-8 border-b-4 border-[var(--theme-border-strong)] pb-6">
                        <div>
                            <p
                                class="font-mono text-xs font-bold uppercase tracking-[0.3em] text-[var(--theme-accent-lime)]"
                            >
                                Operations_Console
                            </p>
                            <h2
                                class="font-display mt-3 text-4xl font-extrabold uppercase tracking-tighter text-white"
                            >
                                {title}
                            </h2>
                        </div>
                    </header>
                    <div class="min-w-0">
                        <slot />
                    </div>
                </main>
            </div>
        </div>

        <script
            define:vars={{
                publicApiUrl,
            }}
        >
            const authScreen = document.getElementById("auth-screen");
            const setupScreen = document.getElementById("setup-screen");
            const appShell = document.getElementById("app-shell");
            const authForm = document.getElementById("auth-form");
            const setupForm = document.getElementById("setup-form");
            const authHandle = document.getElementById("auth-handle");
            const authPassword = document.getElementById("auth-password");
            const authError = document.getElementById("auth-error");
            const authMessage = document.getElementById("auth-message");
            const setupMessage = document.getElementById("setup-message");
            const setupStepLabel = document.getElementById("setup-step-label");
            const setupError = document.getElementById("setup-error");
            const setupConfigFields = document.getElementById(
                "setup-config-fields",
            );
            const setupStepConfig = document.getElementById("setup-step-config");
            const setupStepAdmin = document.getElementById("setup-step-admin");
            const setupBackButton = document.getElementById("setup-back-button");
            const setupNextButton = document.getElementById("setup-next-button");
            const setupSubmitButton = document.getElementById(
                "setup-submit-button",
            );
            const logoutButton = document.getElementById("logout-button");
            let configSchema = [];
            let setupStep = "config";

            function apiPath(path) {
                return `${publicApiUrl}${path}`;
            }

            function clearSetupError() {
                if (setupError) {
                    setupError.classList.add("hidden");
                    setupError.textContent = "";
                }
            }

            function setSetupError(message) {
                if (setupError) {
                    setupError.textContent = message;
                    setupError.classList.remove("hidden");
                }
            }

            function setSetupStep(step) {
                setupStep = step === "admin" ? "admin" : "config";
                const inAdminStep = setupStep === "admin";
                setupStepConfig?.classList.toggle("hidden", inAdminStep);
                setupStepAdmin?.classList.toggle("hidden", !inAdminStep);
                setupBackButton?.classList.toggle("hidden", !inAdminStep);
                setupNextButton?.classList.toggle("hidden", inAdminStep);
                setupSubmitButton?.classList.toggle("hidden", !inAdminStep);
                if (setupStepLabel) {
                    setupStepLabel.textContent = inAdminStep
                        ? "Step 2 of 2 · First account"
                        : "Step 1 of 2 · Configuration";
                }
                if (setupMessage) {
                    setupMessage.textContent = inAdminStep
                        ? "Create the first admin account."
                        : "Configure daemon settings for first run.";
                }
            }

            function validateSetupConfigFields() {
                const fields =
                    setupConfigFields?.querySelectorAll(
                        "[data-setup-config-key]",
                    ) || [];
                for (const element of fields) {
                    if (!(element instanceof HTMLInputElement)) {
                        continue;
                    }
                    const key = element.dataset.setupConfigKey;
                    const field = configSchema.find((entry) => entry.key === key);
                    if (!field) {
                        continue;
                    }
                    const value = element.value.trim();
                    if (field.required && value.length === 0) {
                        return `${field.label} is required.`;
                    }
                    if (
                        field.type === "number" &&
                        value.length > 0 &&
                        Number.isNaN(Number(value))
                    ) {
                        return `${field.label} must be a valid number.`;
                    }
                }
                return null;
            }

            function showAuthScreen(message) {
                if (authMessage && message) {
                    authMessage.textContent = message;
                }
                if (authError) {
                    authError.classList.add("hidden");
                    authError.textContent = "";
                }
                if (authHandle instanceof HTMLInputElement) {
                    authHandle.focus();
                }
                if (authPassword instanceof HTMLInputElement) {
                    authPassword.value = "";
                }
                authScreen?.classList.remove("hidden");
                authScreen?.classList.add("flex");
                setupScreen?.classList.add("hidden");
                setupScreen?.classList.remove("flex");
                appShell?.classList.add("hidden");
            }

            function showSetupScreen(message) {
                clearSetupError();
                authScreen?.classList.add("hidden");
                authScreen?.classList.remove("flex");
                setupScreen?.classList.remove("hidden");
                setupScreen?.classList.add("flex");
                appShell?.classList.add("hidden");
                setSetupStep("config");
                if (setupMessage && message) {
                    setupMessage.textContent = message;
                }
                const adminPassword = document.getElementById(
                    "setup-admin-password",
                );
                if (adminPassword instanceof HTMLInputElement) {
                    adminPassword.value = "";
                }
                const adminPasswordConfirm = document.getElementById(
                    "setup-admin-password-confirm",
                );
                if (adminPasswordConfirm instanceof HTMLInputElement) {
                    adminPasswordConfirm.value = "";
                }
            }

            function showAppShell() {
                authScreen?.classList.add("hidden");
                authScreen?.classList.remove("flex");
                setupScreen?.classList.add("hidden");
                setupScreen?.classList.remove("flex");
                appShell?.classList.remove("hidden");
            }

            async function loadSetupStatus() {
                const response = await fetch(apiPath("/api/v1/setup/status"), {
                    method: "GET",
                });
                if (!response.ok) {
                    return { initialized: true };
                }
                return response.json();
            }

            async function loadConfigSchema() {
                const response = await fetch(apiPath("/api/v1/config/schema"), {
                    method: "GET",
                    credentials: "include",
                });
                if (!response.ok) {
                    throw new Error("Failed to load config schema.");
                }
                return response.json();
            }

            function renderSetupConfigFields(fields) {
                if (!setupConfigFields) {
                    return;
                }
                setupConfigFields.innerHTML = "";
                const sections = groupConfigFields(
                    fields.filter((field) => field.editable_in_setup),
                );
                sections.forEach((section) => {
                    const container = document.createElement("section");
                    container.className =
                        "xl:col-span-2 border-2 border-zinc-700 bg-black p-5";

                    const heading = document.createElement("h2");
                    heading.className =
                        "font-mono text-lg font-bold uppercase text-white";
                    heading.textContent = section.label;

                    const grid = document.createElement("div");
                    grid.className = "mt-4 grid gap-4 xl:grid-cols-2";

                    section.fields.forEach((field) => {
                        const label = document.createElement("label");
                        label.className = "block";

                        const title = document.createElement("span");
                        title.className =
                            "mb-2 block font-mono text-xs font-bold uppercase tracking-[0.16em] text-zinc-300";
                        title.textContent = field.label;

                        const input = document.createElement("input");
                        input.type =
                            field.type === "number" ? "number" : "text";
                        input.value = String(field.default_value ?? "");
                        input.required = Boolean(field.required);
                        input.className =
                            "w-full border-2 border-zinc-700 bg-black px-4 py-3 font-mono text-sm text-zinc-100 outline-none transition duration-100 ease-linear focus:border-[var(--theme-accent-lime)] focus:ring-2 focus:ring-[var(--theme-accent-lime)]";
                        input.dataset.setupConfigKey = field.key;
                        if (field.min_value !== undefined) {
                            input.min = String(field.min_value);
                        }

                        const help = document.createElement("span");
                        help.className = "mt-2 block text-xs text-zinc-500";
                        help.textContent = field.description;

                        label.appendChild(title);
                        label.appendChild(input);
                        label.appendChild(help);
                        grid.appendChild(label);
                    });

                    container.appendChild(heading);
                    container.appendChild(grid);
                    setupConfigFields.appendChild(container);
                });
            }

            function groupConfigFields(fields) {
                const groups = new Map();
                fields.forEach((field) => {
                    if (!groups.has(field.section_key)) {
                        groups.set(field.section_key, {
                            key: field.section_key,
                            label: field.section_label,
                            fields: [],
                        });
                    }
                    groups.get(field.section_key).fields.push(field);
                });
                return Array.from(groups.values());
            }

            async function restoreSession() {
                const response = await fetch(apiPath("/api/v1/session"), {
                    method: "GET",
                    credentials: "include",
                });
                if (response.ok) {
                    showAppShell();
                    return true;
                }
                return false;
            }

            logoutButton?.addEventListener("click", async () => {
                try {
                    await fetch(apiPath("/api/v1/session/logout"), {
                        method: "POST",
                        credentials: "include",
                    });
                } finally {
                    showAuthScreen("Enter account credentials to continue.");
                }
            });

            window.addEventListener("synforge:auth-required", (event) => {
                const detail =
                    event instanceof CustomEvent ? event.detail : null;
                const message =
                    detail?.error?.message ||
                    "The daemon rejected the current session.";
                showAuthScreen(message);
            });

            setupNextButton?.addEventListener("click", () => {
                clearSetupError();
                const validationError = validateSetupConfigFields();
                if (validationError) {
                    setSetupError(validationError);
                    return;
                }
                setSetupStep("admin");
                const handleInput = document.getElementById("setup-admin-handle");
                if (handleInput instanceof HTMLInputElement) {
                    handleInput.focus();
                }
            });

            setupBackButton?.addEventListener("click", () => {
                clearSetupError();
                setSetupStep("config");
            });

            setupForm?.addEventListener("submit", async (event) => {
                event.preventDefault();
                clearSetupError();
                if (setupStep !== "admin") {
                    const validationError = validateSetupConfigFields();
                    if (validationError) {
                        setSetupError(validationError);
                        return;
                    }
                    setSetupStep("admin");
                    const handleInput =
                        document.getElementById("setup-admin-handle");
                    if (handleInput instanceof HTMLInputElement) {
                        handleInput.focus();
                    }
                    return;
                }

                const input = (id) => document.getElementById(id);
                const adminHandle =
                    input("setup-admin-handle") instanceof HTMLInputElement
                        ? input("setup-admin-handle").value.trim()
                        : "";
                const adminDisplayName =
                    input("setup-admin-display-name") instanceof HTMLInputElement
                        ? input("setup-admin-display-name").value.trim()
                        : "";
                const adminPassword =
                    input("setup-admin-password") instanceof HTMLInputElement
                        ? input("setup-admin-password").value
                        : "";
                const adminPasswordConfirm =
                    input("setup-admin-password-confirm") instanceof
                    HTMLInputElement
                        ? input("setup-admin-password-confirm").value
                        : "";

                if (!adminHandle || !adminDisplayName || !adminPassword) {
                    setSetupError(
                        "Admin handle, display name, and password are required.",
                    );
                    return;
                }
                if (adminPassword !== adminPasswordConfirm) {
                    setSetupError("Password confirmation does not match.");
                    return;
                }

                const settings = {};
                setupConfigFields
                    ?.querySelectorAll("[data-setup-config-key]")
                    .forEach((element) => {
                        if (!(element instanceof HTMLInputElement)) {
                            return;
                        }
                        const key = element.dataset.setupConfigKey;
                        const field = configSchema.find(
                            (entry) => entry.key === key,
                        );
                        if (!key || !field) {
                            return;
                        }
                        settings[key] =
                            field.type === "number"
                                ? Number(element.value)
                                : element.value.trim();
                    });
                const payload = {
                    settings,
                    admin: {
                        handle: adminHandle,
                        display_name: adminDisplayName,
                        password: adminPassword,
                    },
                };
                try {
                    const response = await fetch(
                        apiPath("/api/v1/setup/initialize"),
                        {
                            method: "POST",
                            headers: {
                                "Content-Type": "application/json",
                            },
                            body: JSON.stringify(payload),
                        },
                    );
                    if (!response.ok) {
                        const error = await response.json().catch(() => ({
                            message: "Setup failed.",
                        }));
                        setSetupError(error?.message || "Setup failed.");
                        return;
                    }
                    showAuthScreen(
                        "Setup complete. Sign in with the admin account you just created.",
                    );
                } catch {
                    setSetupError("Setup failed.");
                }
            });

            authForm?.addEventListener("submit", async (event) => {
                event.preventDefault();
                const handle =
                    authHandle instanceof HTMLInputElement
                        ? authHandle.value.trim()
                        : "";
                const password =
                    authPassword instanceof HTMLInputElement
                        ? authPassword.value
                        : "";
                if (!handle || !password) {
                    if (authError) {
                        authError.textContent =
                            "Handle and password are required.";
                        authError.classList.remove("hidden");
                    }
                    return;
                }
                try {
                    const response = await fetch(
                        apiPath("/api/v1/session/login"),
                        {
                            method: "POST",
                            headers: {
                                "Content-Type": "application/json",
                            },
                            credentials: "include",
                            body: JSON.stringify({ handle, password }),
                        },
                    );
                    if (!response.ok) {
                        const error = await response.json().catch(() => ({
                            message: "Login failed.",
                        }));
                        if (authError) {
                            authError.textContent =
                                error?.message || "Login failed.";
                            authError.classList.remove("hidden");
                        }
                        return;
                    }
                    showAppShell();
                    window.location.reload();
                } catch {
                    if (authError) {
                        authError.textContent = "Login failed.";
                        authError.classList.remove("hidden");
                    }
                }
            });

            Promise.all([loadSetupStatus(), loadConfigSchema()])
                .then(([status, schema]) => {
                    configSchema = schema.fields || [];
                    renderSetupConfigFields(configSchema);
                    if (!status.initialized) {
                        showSetupScreen(
                            "Create the daemon config file and the initial admin account.",
                        );
                        return;
                    }
                    restoreSession().then((authenticated) => {
                        if (!authenticated) {
                            showAuthScreen(
                                "Use a Synforge account to access the console.",
                            );
                        }
                    });
                })
                .catch(() => {
                    showAuthScreen("Failed to load daemon configuration.");
                });
        </script>
    </body>
</html>
