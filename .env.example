SYNFORGE_BEARER_TOKEN=replace-me
SYNFORGE_PUBLIC_BASE_URL=http://localhost:8080
SYNFORGE_WORKER_IMAGE=synforge-worker-fedora:latest
SYNFORGE_MAX_CONCURRENT_BUILDS=2
SYNFORGE_DB_POOL_SIZE=5
SYNFORGE_QUEUE_BUFFER_SIZE=128
SYNFORGE_POLLER_TICK_SECONDS=30
SYNFORGE_WORKER_RESULT_TIMEOUT_SECONDS=10
SYNFORGE_WORKER_SOCKET_TIMEOUT_SECONDS=30
SYNFORGE_GIT_OPERATION_TIMEOUT_SECONDS=600
