# Copy this file to .env and set non-default credentials before running docker compose.
SYNFORGE_DB_NAME=synforge
SYNFORGE_DB_USER=synforge
SYNFORGE_DB_PASSWORD=change_me_db_password
SYNFORGE_DB_ROOT_PASSWORD=change_me_root_password

# Optional phpMyAdmin host port (enabled only with profile: dev-tools)
SYNFORGE_PHPMYADMIN_PORT=8081
