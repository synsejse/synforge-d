{
  "name": "webui",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "predev": "npm run generate:api",
    "generate:openapi": "cargo run -q -p synforge-daemon --bin openapi-export > openapi.json",
    "generate:types": "openapi-typescript openapi.json -o src/lib/generated/api-schema.ts",
    "generate:api": "npm run generate:openapi && npm run generate:types",
    "build": "astro build",
    "prebuild": "npm run generate:types:fromfile",
    "generate:types:fromfile": "openapi-typescript src/lib/generated/openapi.json -o src/lib/generated/api-schema.ts",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/react": "^5.0.2",
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.3.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "ansi-to-react": "^6.2.6",
    "astro": "^6.1.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-syntax-highlighter": "^16.1.1",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "openapi-fetch": "^0.14.0",
    "openapi-typescript": "^7.10.1"
  }
}
