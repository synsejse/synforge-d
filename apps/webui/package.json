{
  "name": "webui",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "predev": "npm run generate:api",
    "generate:openapi": "mkdir -p src/generated/api && cargo run -q -p synforge-daemon --bin openapi-export > src/generated/api/openapi.json",
    "generate:types": "openapi-typescript src/generated/api/openapi.json -o src/generated/api/api-schema.ts",
    "generate:api": "npm run generate:openapi && npm run generate:types",
    "build": "tsc --noEmit && vite build",
    "prebuild": "sh -c 'if [ -f src/generated/api/openapi.json ]; then npm run generate:types:fromfile; else echo \"Skipping OpenAPI type regeneration: src/generated/api/openapi.json missing\"; fi'",
    "generate:types:fromfile": "openapi-typescript src/generated/api/openapi.json -o src/generated/api/api-schema.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.3.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@radix-ui/themes": "^3.3.0",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-query": "^5.100.6",
    "@tanstack/react-router": "^1.168.26",
    "@tanstack/router-plugin": "^1.167.29",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "ansi-to-react": "^6.2.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-syntax-highlighter": "^16.1.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@tanstack/react-query-devtools": "^5.100.6",
    "@tanstack/router-devtools": "^1.166.13",
    "@vitejs/plugin-react": "^5.2.0",
    "openapi-fetch": "^0.17.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.2"
  }
}
