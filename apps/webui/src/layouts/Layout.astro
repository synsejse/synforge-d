---
import "../styles/global.css";
import FaIcon from "../components/FaIcon";
import { TOKEN_STORAGE_KEY } from "../lib/api";
import {
  faArrowDownWideShort,
  faBoxesStacked,
  faChartLine,
  faCircleHalfStroke,
  faFolderTree,
  faGaugeHigh,
  faSliders,
} from "@fortawesome/free-solid-svg-icons";

interface Props {
  title: string;
}

const { title } = Astro.props;
const currentPath = Astro.url.pathname;
const themeStorageKey = "synforge.theme";

const navItems = [
  { href: "/", label: "Overview", icon: faGaugeHigh, description: "System summary" },
  { href: "/packages/", label: "Packages", icon: faBoxesStacked, description: "Sources and history" },
  { href: "/repository/", label: "Repository", icon: faFolderTree, description: "Published files" },
  { href: "/repository/use/", label: "Add Repo", icon: faArrowDownWideShort, description: "Fedora setup" },
  { href: "/jobs/", label: "Jobs", icon: faChartLine, description: "Runs and live traces" },
  { href: "/settings/", label: "Settings", icon: faSliders, description: "Daemon config" },
];
const themes = [
  { value: "black", label: "Black" },
  { value: "dark", label: "Dark" },
  { value: "light", label: "Light" },
];
---

<!doctype html>
<html lang="en" class="h-full" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Synforge</title>
  </head>
  <body class="h-full overflow-hidden antialiased">
    <div class="fixed inset-0 -z-10 overflow-hidden">
      <div class="app-chrome absolute inset-0"></div>
      <div class="app-grid absolute inset-0 opacity-40"></div>
    </div>

    <div
      id="auth-screen"
      class="hidden min-h-full items-center justify-center px-6 py-12"
    >
      <div class="w-full max-w-md border border-zinc-800 bg-black p-8">
        <div class="mb-8">
          <p class="text-xs font-semibold uppercase tracking-[0.3em] text-zinc-500">Synforge</p>
          <h1 class="mt-3 text-3xl font-semibold text-zinc-50">Authorize WebUI</h1>
          <p id="auth-message" class="mt-3 text-sm leading-6 text-zinc-400">
            Enter the daemon bearer token to manage packages, builds, and logs.
          </p>
        </div>

        <form id="auth-form" class="space-y-4">
          <label class="block">
            <span class="mb-2 block text-sm font-medium text-zinc-300">Bearer token</span>
            <input
              id="auth-token"
              type="password"
              class="w-full border border-zinc-800 bg-black px-4 py-3 text-sm text-zinc-100 outline-none transition focus:border-zinc-600"
              placeholder="Paste token"
              autocomplete="current-password"
            />
          </label>
          <p id="auth-error" class="hidden border border-zinc-800 bg-black px-3 py-2 text-sm text-zinc-300"></p>
          <button
            type="submit"
            class="w-full border border-zinc-200 bg-zinc-100 px-4 py-3 text-sm font-semibold text-black transition hover:bg-white"
          >
            Enter Console
          </button>
        </form>
      </div>
    </div>

    <div id="app-shell" class="h-screen box-border px-3 py-3 lg:px-5 lg:py-5">
      <div class="grid h-full gap-3 xl:grid-cols-[272px_minmax(0,1fr)]">
        <aside class="flex min-h-0 flex-col border border-zinc-800 bg-black p-4">
          <div class="border border-zinc-800 bg-black px-4 py-3">
            <div class="text-xs uppercase tracking-[0.35em] text-zinc-500">Synforge</div>
            <h1 class="mt-2 text-xl font-semibold tracking-tight text-white">Build Control</h1>
          </div>

          <nav class="mt-4 flex-1 space-y-2 overflow-auto">
            {navItems.map((item) => (
              <a
                href={item.href}
                class:list={[
                  "group block border px-4 py-4 transition",
                  currentPath === item.href || (item.href !== "/" && currentPath === item.href.slice(0, -1))
                    ? "border-zinc-600 bg-zinc-950"
                    : "border-transparent bg-transparent hover:border-zinc-800 hover:bg-zinc-950",
                ]}
              >
                <div class="flex items-center gap-3">
                  <div class="flex h-10 w-10 items-center justify-center border border-zinc-800 bg-black text-lg text-white">
                    <FaIcon icon={item.icon} />
                  </div>
                  <div>
                    <div class="text-sm font-semibold text-zinc-100">{item.label}</div>
                    <div class="text-xs text-zinc-500">{item.description}</div>
                  </div>
                </div>
              </a>
            ))}
          </nav>

          <div class="mt-auto pt-4">
            <div class="border border-zinc-800 bg-black p-4">
            <div class="mb-4">
              <div class="flex items-center gap-2 text-xs uppercase tracking-[0.2em] text-zinc-500">
                <FaIcon icon={faCircleHalfStroke} />
                Theme
              </div>
              <div class="mt-3 grid gap-2">
                {themes.map((theme) => (
                  <button
                    type="button"
                    class="theme-button border border-zinc-800 bg-black px-4 py-2.5 text-left text-sm font-medium text-zinc-200 transition hover:border-zinc-600 hover:bg-zinc-950"
                    data-theme-value={theme.value}
                  >
                    {theme.label}
                  </button>
                ))}
              </div>
            </div>
            <div class="text-xs uppercase tracking-[0.2em] text-zinc-500">Session</div>
            <button
              id="logout-button"
              type="button"
              class="mt-3 w-full border border-zinc-800 bg-black px-4 py-2.5 text-left text-sm font-medium text-zinc-200 transition hover:border-zinc-600 hover:bg-zinc-950"
            >
              Change bearer token
            </button>
            </div>
          </div>
        </aside>

        <main class="min-h-0 overflow-auto border border-zinc-800 bg-black p-4 lg:p-6">
          <header class="mb-6 border-b border-white/8 pb-5">
            <div>
              <p class="text-xs uppercase tracking-[0.28em] text-zinc-500">Operations Console</p>
              <h2 class="mt-2 text-3xl font-semibold tracking-tight text-white">{title}</h2>
            </div>
          </header>
          <div class="min-w-0">
            <slot />
          </div>
        </main>
      </div>
    </div>

    <script define:vars={{ tokenStorageKey: TOKEN_STORAGE_KEY, themeStorageKey }}>
      const authScreen = document.getElementById("auth-screen");
      const appShell = document.getElementById("app-shell");
      const authForm = document.getElementById("auth-form");
      const authToken = document.getElementById("auth-token");
      const authError = document.getElementById("auth-error");
      const authMessage = document.getElementById("auth-message");
      const logoutButton = document.getElementById("logout-button");
      const themeButtons = Array.from(document.querySelectorAll("[data-theme-value]"));

      function applyTheme(theme) {
        const normalized = ["black", "dark", "light"].includes(theme) ? theme : "dark";
        document.documentElement.setAttribute("data-theme", normalized);
        window.localStorage.setItem(themeStorageKey, normalized);
        themeButtons.forEach((button) => {
          const active = button.getAttribute("data-theme-value") === normalized;
          button.classList.toggle("border-zinc-600", active);
          button.classList.toggle("bg-zinc-950", active);
        });
      }

      function showAuthScreen(message, clearToken = false) {
        if (clearToken) {
          window.localStorage.removeItem(tokenStorageKey);
        }
        if (authMessage && message) {
          authMessage.textContent = message;
        }
        if (authError) {
          authError.classList.add("hidden");
          authError.textContent = "";
        }
        if (authToken) {
          authToken.value = "";
          authToken.focus();
        }
        authScreen?.classList.remove("hidden");
        authScreen?.classList.add("flex");
        appShell?.classList.add("hidden");
      }

      function showAppShell() {
        authScreen?.classList.add("hidden");
        authScreen?.classList.remove("flex");
        appShell?.classList.remove("hidden");
      }

      logoutButton?.addEventListener("click", () => {
        showAuthScreen("Enter a bearer token to continue.", true);
      });

      themeButtons.forEach((button) => {
        button.addEventListener("click", () => {
          applyTheme(button.getAttribute("data-theme-value"));
        });
      });

      window.addEventListener("synforge:auth-required", (event) => {
        const detail = event instanceof CustomEvent ? event.detail : null;
        const message =
          detail?.error?.message || "The daemon rejected the current bearer token.";
        showAuthScreen(message, true);
      });

      authForm?.addEventListener("submit", (event) => {
        event.preventDefault();
        const token = authToken instanceof HTMLInputElement ? authToken.value.trim() : "";
        if (!token) {
          if (authError) {
            authError.textContent = "Bearer token is required.";
            authError.classList.remove("hidden");
          }
          return;
        }
        window.localStorage.setItem(tokenStorageKey, token);
        showAppShell();
        window.location.reload();
      });

      applyTheme(window.localStorage.getItem(themeStorageKey) || "dark");
      showAppShell();
    </script>
  </body>
</html>
