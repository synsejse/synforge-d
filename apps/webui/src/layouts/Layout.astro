---
import "../styles/global.css";
import FaIcon from "../components/FaIcon";
import {
    faArrowDownWideShort,
    faBoxesStacked,
    faBookOpen,
    faChartLine,
    faCircleHalfStroke,
    faFolderTree,
    faGaugeHigh,
    faSliders,
    faUsers,
} from "@fortawesome/free-solid-svg-icons";

interface Props {
    title: string;
}

const { title } = Astro.props;
const currentPath = Astro.url.pathname;
const themeStorageKey = "synforge.theme";
const publicApiUrl = import.meta.env.PUBLIC_API_URL || "";

const navItems = [
    {
        href: "/",
        label: "Overview",
        icon: faGaugeHigh,
        description: "System summary",
    },
    {
        href: "/packages/",
        label: "Packages",
        icon: faBoxesStacked,
        description: "Sources and history",
    },
    {
        href: "/repository/",
        label: "Repository",
        icon: faFolderTree,
        description: "Published files",
    },
    {
        href: "/repository/use/",
        label: "Add Repo",
        icon: faArrowDownWideShort,
        description: "Fedora setup",
    },
    {
        href: "/jobs/",
        label: "Jobs",
        icon: faChartLine,
        description: "Runs and live traces",
    },
    {
        href: "/users/",
        label: "Users",
        icon: faUsers,
        description: "Accounts and permissions",
    },
    {
        href: "/docs/",
        label: "Docs",
        icon: faBookOpen,
        description: "API reference",
    },
    {
        href: "/settings/",
        label: "Settings",
        icon: faSliders,
        description: "Daemon config",
    },
];
const themes = [
    { value: "black", label: "Black" },
    { value: "dark", label: "Dark" },
    { value: "light", label: "Light" },
];
---

<!doctype html>
<html lang="en" class="h-full" data-theme="dark">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title} | Synforge</title>
    </head>
    <body class="h-full overflow-hidden antialiased">
        <a
            href="#main-content"
            class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:border focus:border-zinc-200 focus:bg-zinc-100 focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-black"
        >
            Skip to main content
        </a>
        <div class="fixed inset-0 -z-10 overflow-hidden">
            <div class="app-chrome absolute inset-0"></div>
            <div class="app-grid absolute inset-0 opacity-40"></div>
        </div>

        <div
            id="auth-screen"
            class="hidden min-h-full items-center justify-center px-6 py-12"
        >
            <div class="w-full max-w-md border border-zinc-800 bg-black p-8">
                <div class="mb-8">
                    <p
                        class="text-xs font-semibold uppercase tracking-[0.3em] text-zinc-500"
                    >
                        Synforge
                    </p>
                    <h1 class="mt-3 text-3xl font-semibold text-zinc-50">
                        Authorize WebUI
                    </h1>
                    <p
                        id="auth-message"
                        class="mt-3 text-sm leading-6 text-zinc-400"
                    >
                        Enter a valid account handle and password to manage
                        packages, builds, and logs.
                    </p>
                </div>

                <form id="auth-form" class="space-y-4">
                    <label class="block">
                        <span
                            class="mb-2 block text-sm font-medium text-zinc-300"
                            >Handle</span
                        >
                        <input
                            id="auth-handle"
                            type="text"
                            class="w-full border border-zinc-800 bg-black px-4 py-3 text-sm text-zinc-100 outline-none transition focus:border-zinc-600"
                            placeholder="admin"
                            autocomplete="username"
                        />
                    </label>
                    <label class="block">
                        <span
                            class="mb-2 block text-sm font-medium text-zinc-300"
                            >Password</span
                        >
                        <input
                            id="auth-password"
                            type="password"
                            class="w-full border border-zinc-800 bg-black px-4 py-3 text-sm text-zinc-100 outline-none transition focus:border-zinc-600"
                            placeholder="Password"
                            autocomplete="current-password"
                        />
                    </label>
                    <p
                        id="auth-error"
                        class="hidden border border-zinc-800 bg-black px-3 py-2 text-sm text-zinc-300"
                    >
                    </p>
                    <button
                        type="submit"
                        class="w-full border border-zinc-200 bg-zinc-100 px-4 py-3 text-sm font-semibold text-black transition hover:bg-white"
                    >
                        Enter Console
                    </button>
                </form>
            </div>
        </div>

        <div
            id="setup-screen"
            class="hidden min-h-full items-center justify-center px-6 py-12"
        >
            <div class="w-full max-w-3xl border border-zinc-800 bg-black p-8">
                <div class="mb-8">
                    <p
                        class="text-xs font-semibold uppercase tracking-[0.3em] text-zinc-500"
                    >
                        Synforge
                    </p>
                    <h1 class="mt-3 text-3xl font-semibold text-zinc-50">
                        First Run Setup
                    </h1>
                    <p
                        id="setup-message"
                        class="mt-3 text-sm leading-6 text-zinc-400"
                    >
                        Create the daemon config file and the initial admin
                        account.
                    </p>
                </div>

                <form id="setup-form" class="grid gap-4 xl:grid-cols-2">
                    <div id="setup-config-fields" class="contents"></div>
                    <label class="block">
                        <span
                            class="mb-2 block text-sm font-medium text-zinc-300"
                            >Admin handle</span
                        >
                        <input
                            id="setup-admin-handle"
                            type="text"
                            value="admin"
                            class="w-full border border-zinc-800 bg-black px-4 py-3 text-sm text-zinc-100 outline-none transition focus:border-zinc-600"
                        />
                    </label>
                    <label class="block">
                        <span
                            class="mb-2 block text-sm font-medium text-zinc-300"
                            >Admin display name</span
                        >
                        <input
                            id="setup-admin-display-name"
                            type="text"
                            value="Administrator"
                            class="w-full border border-zinc-800 bg-black px-4 py-3 text-sm text-zinc-100 outline-none transition focus:border-zinc-600"
                        />
                    </label>
                    <label class="block xl:col-span-2">
                        <span
                            class="mb-2 block text-sm font-medium text-zinc-300"
                            >Admin password</span
                        >
                        <input
                            id="setup-admin-password"
                            type="password"
                            class="w-full border border-zinc-800 bg-black px-4 py-3 text-sm text-zinc-100 outline-none transition focus:border-zinc-600"
                            placeholder="Choose a strong password"
                        />
                    </label>
                    <p
                        id="setup-error"
                        class="hidden xl:col-span-2 border border-zinc-800 bg-black px-3 py-2 text-sm text-zinc-300"
                    >
                    </p>
                    <div class="xl:col-span-2 flex justify-end">
                        <button
                            type="submit"
                            class="border border-zinc-200 bg-zinc-100 px-4 py-3 text-sm font-semibold text-black transition hover:bg-white"
                        >
                            Initialize Synforge
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div
            id="app-shell"
            class="hidden h-screen box-border px-3 py-3 lg:px-5 lg:py-5"
        >
            <div class="grid h-full gap-3 xl:grid-cols-[272px_minmax(0,1fr)]">
                <aside
                    class="flex min-h-0 flex-col border border-zinc-800 bg-black p-4"
                >
                    <div class="border border-zinc-800 bg-black px-4 py-3">
                        <div
                            class="text-xs uppercase tracking-[0.35em] text-zinc-500"
                        >
                            Synforge
                        </div>
                        <h1
                            class="mt-2 text-xl font-semibold tracking-tight text-white"
                        >
                            Build Control
                        </h1>
                    </div>

                    <nav
                        class="mt-4 flex-1 space-y-2 overflow-auto"
                        aria-label="Primary navigation"
                    >
                        {
                            navItems.map((item) => (
                                <a
                                    href={item.href}
                                    aria-current={
                                        currentPath === item.href ||
                                        (item.href !== "/" &&
                                            currentPath ===
                                                item.href.slice(0, -1))
                                            ? "page"
                                            : undefined
                                    }
                                    class:list={[
                                        "group block border px-4 py-4 transition",
                                        currentPath === item.href ||
                                        (item.href !== "/" &&
                                            currentPath ===
                                                item.href.slice(0, -1))
                                            ? "border-zinc-600 bg-zinc-950"
                                            : "border-transparent bg-transparent hover:border-zinc-800 hover:bg-zinc-950",
                                    ]}
                                >
                                    <div class="flex items-center gap-3">
                                        <div class="flex h-10 w-10 items-center justify-center border border-zinc-800 bg-black text-lg text-white">
                                            <FaIcon icon={item.icon} />
                                        </div>
                                        <div>
                                            <div class="text-sm font-semibold text-zinc-100">
                                                {item.label}
                                            </div>
                                            <div class="text-xs text-zinc-500">
                                                {item.description}
                                            </div>
                                        </div>
                                    </div>
                                </a>
                            ))
                        }
                    </nav>

                    <div class="mt-auto pt-4">
                        <div class="border border-zinc-800 bg-black p-4">
                            <div class="mb-4">
                                <div
                                    class="flex items-center gap-2 text-xs uppercase tracking-[0.2em] text-zinc-500"
                                >
                                    <FaIcon icon={faCircleHalfStroke} />
                                    Theme
                                </div>
                                <label class="mt-3 block">
                                    <span class="sr-only">Select theme</span>
                                    <select
                                        id="theme-select"
                                        class="w-full border border-zinc-800 bg-black px-4 py-2.5 text-sm font-medium text-zinc-200 outline-none transition focus:border-zinc-600"
                                    >
                                        {
                                            themes.map((theme) => (
                                                <option value={theme.value}>
                                                    {theme.label}
                                                </option>
                                            ))
                                        }
                                    </select>
                                </label>
                            </div>
                            <div
                                class="text-xs uppercase tracking-[0.2em] text-zinc-500"
                            >
                                Session
                            </div>
                            <button
                                id="logout-button"
                                type="button"
                                class="mt-3 w-full border border-zinc-800 bg-black px-4 py-2.5 text-left text-sm font-medium text-zinc-200 transition hover:border-zinc-600 hover:bg-zinc-950"
                            >
                                Change account
                            </button>
                        </div>
                    </div>
                </aside>

                <main
                    id="main-content"
                    tabindex="-1"
                    class="min-h-0 overflow-auto border border-zinc-800 bg-black p-4 lg:p-6"
                >
                    <header class="mb-6 border-b border-white/8 pb-5">
                        <div>
                            <p
                                class="text-xs uppercase tracking-[0.28em] text-zinc-500"
                            >
                                Operations Console
                            </p>
                            <h2
                                class="mt-2 text-3xl font-semibold tracking-tight text-white"
                            >
                                {title}
                            </h2>
                        </div>
                    </header>
                    <div class="min-w-0">
                        <slot />
                    </div>
                </main>
            </div>
        </div>

        <script
            define:vars={{
                themeStorageKey,
                publicApiUrl,
            }}
        >
            const authScreen = document.getElementById("auth-screen");
            const setupScreen = document.getElementById("setup-screen");
            const appShell = document.getElementById("app-shell");
            const authForm = document.getElementById("auth-form");
            const setupForm = document.getElementById("setup-form");
            const authHandle = document.getElementById("auth-handle");
            const authPassword = document.getElementById("auth-password");
            const authError = document.getElementById("auth-error");
            const authMessage = document.getElementById("auth-message");
            const setupMessage = document.getElementById("setup-message");
            const setupError = document.getElementById("setup-error");
            const setupConfigFields = document.getElementById(
                "setup-config-fields",
            );
            const logoutButton = document.getElementById("logout-button");
            const themeSelect = document.getElementById("theme-select");
            let configSchema = [];

            function applyTheme(theme) {
                const normalized = ["black", "dark", "light"].includes(theme)
                    ? theme
                    : "dark";
                document.documentElement.setAttribute("data-theme", normalized);
                window.localStorage.setItem(themeStorageKey, normalized);
                if (themeSelect instanceof HTMLSelectElement) {
                    themeSelect.value = normalized;
                }
            }

            function apiPath(path) {
                return `${publicApiUrl}${path}`;
            }

            function showAuthScreen(message) {
                if (authMessage && message) {
                    authMessage.textContent = message;
                }
                if (authError) {
                    authError.classList.add("hidden");
                    authError.textContent = "";
                }
                if (authHandle instanceof HTMLInputElement) {
                    authHandle.focus();
                }
                if (authPassword instanceof HTMLInputElement) {
                    authPassword.value = "";
                }
                authScreen?.classList.remove("hidden");
                authScreen?.classList.add("flex");
                setupScreen?.classList.add("hidden");
                setupScreen?.classList.remove("flex");
                appShell?.classList.add("hidden");
            }

            function showSetupScreen(message) {
                if (setupMessage && message) {
                    setupMessage.textContent = message;
                }
                if (setupError) {
                    setupError.classList.add("hidden");
                    setupError.textContent = "";
                }
                authScreen?.classList.add("hidden");
                authScreen?.classList.remove("flex");
                setupScreen?.classList.remove("hidden");
                setupScreen?.classList.add("flex");
                appShell?.classList.add("hidden");
            }

            function showAppShell() {
                authScreen?.classList.add("hidden");
                authScreen?.classList.remove("flex");
                setupScreen?.classList.add("hidden");
                setupScreen?.classList.remove("flex");
                appShell?.classList.remove("hidden");
                requestAnimationFrame(() => {
                    document.getElementById("main-content")?.focus();
                });
            }

            async function loadSetupStatus() {
                const response = await fetch(apiPath("/api/v1/setup/status"), {
                    method: "GET",
                });
                if (!response.ok) {
                    return { initialized: true };
                }
                return response.json();
            }

            async function loadConfigSchema() {
                const response = await fetch(apiPath("/api/v1/config/schema"), {
                    method: "GET",
                    credentials: "include",
                });
                if (!response.ok) {
                    throw new Error("Failed to load config schema.");
                }
                return response.json();
            }

            function renderSetupConfigFields(fields) {
                if (!setupConfigFields) {
                    return;
                }
                setupConfigFields.innerHTML = "";
                fields
                    .filter((field) => field.editable_in_setup)
                    .forEach((field) => {
                        const label = document.createElement("label");
                        label.className = "block";

                        const title = document.createElement("span");
                        title.className =
                            "mb-2 block text-sm font-medium text-zinc-300";
                        title.textContent = field.label;

                        const input = document.createElement("input");
                        input.type =
                            field.type === "number" ? "number" : "text";
                        input.value = String(field.default_value ?? "");
                        input.required = Boolean(field.required);
                        input.className =
                            "w-full border border-zinc-800 bg-black px-4 py-3 text-sm text-zinc-100 outline-none transition focus:border-zinc-600";
                        input.dataset.setupConfigKey = field.key;
                        if (field.min_value !== undefined) {
                            input.min = String(field.min_value);
                        }

                        const help = document.createElement("span");
                        help.className = "mt-2 block text-xs text-zinc-500";
                        help.textContent = field.description;

                        label.appendChild(title);
                        label.appendChild(input);
                        label.appendChild(help);
                        setupConfigFields.appendChild(label);
                    });
            }

            async function restoreSession() {
                const response = await fetch(apiPath("/api/v1/session"), {
                    method: "GET",
                    credentials: "include",
                });
                if (response.ok) {
                    showAppShell();
                    return true;
                }
                return false;
            }

            logoutButton?.addEventListener("click", async () => {
                try {
                    await fetch(apiPath("/api/v1/session/logout"), {
                        method: "POST",
                        credentials: "include",
                    });
                } finally {
                    showAuthScreen("Enter account credentials to continue.");
                }
            });

            themeSelect?.addEventListener("change", () => {
                if (themeSelect instanceof HTMLSelectElement) {
                    applyTheme(themeSelect.value);
                }
            });

            window.addEventListener("synforge:auth-required", (event) => {
                const detail =
                    event instanceof CustomEvent ? event.detail : null;
                const message =
                    detail?.error?.message ||
                    "The daemon rejected the current session.";
                showAuthScreen(message);
            });

            setupForm?.addEventListener("submit", async (event) => {
                event.preventDefault();
                const input = (id) => document.getElementById(id);
                const settings = {};
                setupConfigFields
                    ?.querySelectorAll("[data-setup-config-key]")
                    .forEach((element) => {
                        if (!(element instanceof HTMLInputElement)) {
                            return;
                        }
                        const key = element.dataset.setupConfigKey;
                        const field = configSchema.find(
                            (entry) => entry.key === key,
                        );
                        if (!key || !field) {
                            return;
                        }
                        settings[key] =
                            field.type === "number"
                                ? Number(element.value)
                                : element.value.trim();
                    });
                const payload = {
                    settings,
                    admin: {
                        handle:
                            input("setup-admin-handle") instanceof
                            HTMLInputElement
                                ? input("setup-admin-handle").value.trim()
                                : "",
                        display_name:
                            input("setup-admin-display-name") instanceof
                            HTMLInputElement
                                ? input("setup-admin-display-name").value.trim()
                                : "",
                        password:
                            input("setup-admin-password") instanceof
                            HTMLInputElement
                                ? input("setup-admin-password").value
                                : "",
                    },
                };
                try {
                    const response = await fetch(
                        apiPath("/api/v1/setup/initialize"),
                        {
                            method: "POST",
                            headers: {
                                "Content-Type": "application/json",
                            },
                            body: JSON.stringify(payload),
                        },
                    );
                    if (!response.ok) {
                        const error = await response.json().catch(() => ({
                            message: "Setup failed.",
                        }));
                        if (setupError) {
                            setupError.textContent =
                                error?.message || "Setup failed.";
                            setupError.classList.remove("hidden");
                        }
                        return;
                    }
                    showAuthScreen(
                        "Setup complete. Sign in with the admin account you just created.",
                    );
                } catch {
                    if (setupError) {
                        setupError.textContent = "Setup failed.";
                        setupError.classList.remove("hidden");
                    }
                }
            });

            authForm?.addEventListener("submit", async (event) => {
                event.preventDefault();
                const handle =
                    authHandle instanceof HTMLInputElement
                        ? authHandle.value.trim()
                        : "";
                const password =
                    authPassword instanceof HTMLInputElement
                        ? authPassword.value
                        : "";
                if (!handle || !password) {
                    if (authError) {
                        authError.textContent =
                            "Handle and password are required.";
                        authError.classList.remove("hidden");
                    }
                    return;
                }
                try {
                    const response = await fetch(
                        apiPath("/api/v1/session/login"),
                        {
                            method: "POST",
                            headers: {
                                "Content-Type": "application/json",
                            },
                            credentials: "include",
                            body: JSON.stringify({ handle, password }),
                        },
                    );
                    if (!response.ok) {
                        const error = await response.json().catch(() => ({
                            message: "Login failed.",
                        }));
                        if (authError) {
                            authError.textContent =
                                error?.message || "Login failed.";
                            authError.classList.remove("hidden");
                        }
                        return;
                    }
                    showAppShell();
                    window.location.reload();
                } catch {
                    if (authError) {
                        authError.textContent = "Login failed.";
                        authError.classList.remove("hidden");
                    }
                }
            });

            applyTheme(window.localStorage.getItem(themeStorageKey) || "dark");
            Promise.all([loadSetupStatus(), loadConfigSchema()])
                .then(([status, schema]) => {
                    configSchema = schema.fields || [];
                    renderSetupConfigFields(configSchema);
                    if (!status.initialized) {
                        showSetupScreen(
                            "Create the daemon config file and the initial admin account.",
                        );
                        return;
                    }
                    restoreSession().then((authenticated) => {
                        if (!authenticated) {
                            showAuthScreen(
                                "Use a Synforge account to access the console.",
                            );
                        }
                    });
                })
                .catch(() => {
                    showAuthScreen("Failed to load daemon configuration.");
                });
        </script>
    </body>
</html>
