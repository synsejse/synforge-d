---
import "../styles/global.css";
import AppShell from "../features/app-shell/AppShell.astro";
import { radixCustomStyles } from "../lib/radix-theme";

interface Props {
    title: string;
    chrome?: boolean;
    authMode?: "protected" | "public";
}

const { title, chrome = true, authMode = "protected" } = Astro.props;
const currentPath = Astro.url.pathname;
const publicApiUrl = import.meta.env.PUBLIC_API_URL || "";
---

<!doctype html>
<html lang="en" class="h-full" data-theme="dark">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title} | Synforge</title>
        <style set:html={radixCustomStyles} />
    </head>
    <body
        class="h-full overflow-x-auto overflow-y-auto antialiased lg:overflow-hidden"
        data-public-api-url={publicApiUrl}
        data-auth-mode={authMode}
    >
        <a
            href="#main-content"
            class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:border focus:border-zinc-200 focus:bg-zinc-100 focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-black"
        >
            Skip to main content
        </a>
        <div class="fixed inset-0 -z-10 overflow-hidden">
            <div class="app-chrome absolute inset-0"></div>
            <div class="app-grid absolute inset-0 opacity-60"></div>
        </div>

        {
            chrome ? (
                <AppShell currentPath={currentPath}>
                    <slot />
                </AppShell>
            ) : (
                <main id="main-content" class="min-h-full">
                    <slot />
                </main>
            )
        }

        <script>
            import "../features/app-shell/layout-client";
            import "../features/app-shell/route-guard";
        </script>
    </body>
</html>
