# Required: set every __SET_ME__ value before starting the stack.
# The daemon refuses to boot with these literal placeholder values.

SYNFORGE_DB_NAME=synforge
SYNFORGE_DB_USER=synforge
SYNFORGE_DB_PASSWORD=__SET_ME__

# Persistent data paths (host bind mounts; point at large disks for production)
SYNFORGE_DB_PATH=/data/postgres
SYNFORGE_REDIS_PATH=/data/redis
SYNFORGE_RUNTIME_PATH=/data/runtime
SYNFORGE_WORKER_JOBS_PATH=/data/jobs

# Only required if you launch the debug-tools profile.
SYNFORGE_PGADMIN_EMAIL=admin@example.com
SYNFORGE_PGADMIN_PASSWORD=__SET_ME__
SYNFORGE_PGADMIN_PORT=5050
SYNFORGE_PGADMIN_PATH=/data/pgadmin
