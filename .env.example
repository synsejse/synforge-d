# Copy this file to .env and set non-default credentials before running docker compose.
SYNFORGE_DB_NAME=synforge
SYNFORGE_DB_USER=synforge
SYNFORGE_DB_PASSWORD=change_me_db_password
SYNFORGE_OBJECT_STORAGE_BUCKET=synforge
SYNFORGE_OBJECT_STORAGE_REGION=us-east-1
SYNFORGE_OBJECT_STORAGE_ACCESS_KEY_ID=synforge-minio
SYNFORGE_OBJECT_STORAGE_SECRET_ACCESS_KEY=change_me_minio_secret

# Host paths for persistent storage (absolute paths recommended)
# For VMs with small boot drives, point these to large data disk mounts
SYNFORGE_DB_PATH=/data/db
SYNFORGE_REDIS_PATH=/data/redis
SYNFORGE_OBJECT_STORAGE_PATH=/data/object-storage
SYNFORGE_RUNTIME_PATH=/data/runtime
SYNFORGE_WORKER_JOBS_PATH=/data/worker-jobs
SYNFORGE_OBJECT_STORAGE_PATH_STYLE=true

# MinIO host ports
SYNFORGE_MINIO_API_PORT=9000
SYNFORGE_MINIO_CONSOLE_PORT=9001

# Optional debug tools (`docker compose --profile debug-tools up`)
SYNFORGE_PGADMIN_EMAIL=admin@example.com
SYNFORGE_PGADMIN_PASSWORD=change_me_pgadmin_password
SYNFORGE_PGADMIN_PORT=5050
SYNFORGE_PGADMIN_PATH=/data/pgadmin
SYNFORGE_MINIO_VIEWER_PORT=8070
