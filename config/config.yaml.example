listen_addr: "0.0.0.0:8080"
runtime_root: "/var/lib/synforge"
worker_image: "synforge-worker-fedora:latest"
# If left as-is, the daemon will replace this placeholder with a generated secret on first run.
session_secret: "synforge-dev-session-secret-change-me"
bootstrap_completed: false
max_concurrent_builds: 2
db_pool_size: 5
queue_buffer_size: 128
poller_tick_seconds: 30
worker_result_timeout_seconds: 10
worker_socket_timeout_seconds: 30
git_operation_timeout_seconds: 600
public_base_url: "http://localhost:8080"
